# Server port (default: 3000)
PORT=3000

# Database type: sqlite | mongodb (default: sqlite)
DB_TYPE=sqlite

# SQLite database file path (default: ./data/megagrind.db)
SQLITE_PATH=./data/megagrind.db

# MongoDB connection URI (required when DB_TYPE=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=megagrind
